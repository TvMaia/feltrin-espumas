---
// Seção 15 — Oferta final.
// Repete a promessa única e dá o próximo passo com o atrito mais baixo
// possível: mandar a medida pelo WhatsApp. Sem formulário, sem cadastro.
import Figura from './Figura.astro';
import { zap } from '../dados';

const linkFinal = zap(
  'Olá! Quero orçamento. Vou mandar a aplicação e as medidas aqui.'
);
---

<section class="secao oferta" id="orcamento">
  <div class="oferta__fundo" aria-hidden="true"></div>

  <div class="caixa oferta__caixa">
    <div class="oferta__texto">
      <p class="olho">Último passo</p>
      <h2 class="h-mega oferta__h2">
        Mande a aplicação e a medida.<br />
        <span class="oferta__destaque">O resto é conta, não conversa.</span>
      </h2>
      <p class="lede">
        Você recebe o valor fechado da peça, a densidade recomendada para aquele uso
        e o prazo real. Se a gente achar que a densidade mais barata resolve o seu
        caso, é essa que vai no orçamento.
      </p>

      <ol class="oferta__passos">
        <li>Manda o que vai estofar e as medidas (ou a foto com a fita)</li>
        <li>Recebe a densidade recomendada e o valor fechado</li>
        <li>Aprova e a peça entra na fila de corte com código de lote</li>
      </ol>

      <div class="btn-grupo">
        <a class="btn oferta__btn" href={linkFinal} target="_blank" rel="noopener">
          Pedir meu orçamento no WhatsApp
          <svg class="btn__seta" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m-6-7 7 7-7 7" stroke="currentColor" stroke-width="2" />
          </svg>
        </a>
      </div>
      <p class="sob-btn">
        Sem formulário, sem cadastro e sem ligação de vendedor depois.
      </p>
    </div>

    <Figura
      src="img/oferta-carregamento.png"
      alt="Peças de espuma cortadas, etiquetadas e empilhadas prontas para carregamento na saída da oficina"
      legenda="Pedido etiquetado e pronto para sair. Cada peça com o código do lote que você vai usar para repetir o pedido na próxima vez."
      largura={2000}
      altura={1500}
      classe="oferta__figura"
    />
  </div>
</section>

<style>
  .oferta {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
  }

  .oferta__fundo {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(800px 500px at 85% 115%, rgba(47, 192, 99, 0.2), transparent 70%),
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 100% 100%, 76px 100%;
    pointer-events: none;
  }

  .oferta__caixa {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 4.5vw, 3.75rem);
    align-items: center;
  }

  .oferta__h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.6rem);
  }

  .oferta__destaque {
    color: var(--verde-400);
  }

  .oferta__passos {
    list-style: none;
    counter-reset: op;
    margin: 2rem 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .oferta__passos li {
    counter-increment: op;
    position: relative;
    padding-left: 2.4rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
  }

  .oferta__passos li::before {
    content: counter(op);
    position: absolute;
    left: 0;
    top: -0.05em;
    width: 1.55rem;
    height: 1.55rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--verde-400);
    color: var(--verde-400);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .oferta__btn {
    padding: 1.2rem 1.9rem;
    font-size: 1.02rem;
  }

  @media (min-width: 960px) {
    .oferta__caixa {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
</style>
