---
import Layout from '../layouts/Layout.astro';
import Topo from '../components/Topo.astro';
import Hero from '../components/Hero.astro';
import BarraConfianca from '../components/BarraConfianca.astro';
import Problema from '../components/Problema.astro';
import Mecanismo from '../components/Mecanismo.astro';
import TabelaDensidades from '../components/TabelaDensidades.astro';
import CorteSobMedida from '../components/CorteSobMedida.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Comparativo from '../components/Comparativo.astro';
import Publico from '../components/Publico.astro';
import ComoMedir from '../components/ComoMedir.astro';
import EstofadosProva from '../components/EstofadosProva.astro';
import QuemCorta from '../components/QuemCorta.astro';
import Garantia from '../components/Garantia.astro';
import Objecoes from '../components/Objecoes.astro';
import OfertaFinal from '../components/OfertaFinal.astro';
import Rodape from '../components/Rodape.astro';
import { zap } from '../dados';

const linkFlutuante = zap('Olá! Vim pelo site e quero um orçamento.');
---

<Layout
  titulo="Feltrin — espuma com densidade conferida por lote e corte sob medida | São Paulo"
  descricao="Fornecedor de espuma para estofarias, marcenarias e fábricas em São Paulo. Densidade conferida por lote, etiqueta na peça e corte sob medida no esquadro. Também fazemos reforma de estofados."
>
  <Topo />

  <main>
    <Hero />
    <BarraConfianca />
    <Problema />
    <Mecanismo />
    <TabelaDensidades />
    <CorteSobMedida />
    <ProvaSocial />
    <Comparativo />
    <Publico />
    <ComoMedir />
    <EstofadosProva />
    <QuemCorta />
    <Garantia />
    <Objecoes />
    <OfertaFinal />
  </main>

  <Rodape />

  <a
    class="zap"
    href={linkFlutuante}
    target="_blank"
    rel="noopener"
    aria-label="Falar no WhatsApp"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2zm0 18.02c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.08 8.08 0 01-1.24-4.3c0-4.47 3.64-8.1 8.11-8.1 4.48 0 8.11 3.63 8.11 8.1 0 4.48-3.63 8.11-8.11 8.11zm4.47-6.07c-.25-.12-1.45-.71-1.67-.79-.22-.08-.39-.12-.55.13-.16.25-.63.79-.78.95-.14.16-.28.18-.53.06-.25-.12-1.05-.39-2-1.23a7.4 7.4 0 01-1.37-1.71c-.14-.25-.02-.38.11-.5.11-.11.25-.3.37-.44.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2 0 1.19.86 2.33.98 2.49.12.16 1.7 2.6 4.12 3.55 2.42.95 2.42.63 2.86.59.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.47-.28z"
      />
    </svg>
  </a>
</Layout>

<style>
  /* Botão flutuante: paridade com o Join.chat do site atual, sem o plugin. */
  .zap {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 60;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #06210f;
    border-radius: 50%;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6);
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .zap svg {
    width: 30px;
    height: 30px;
  }

  .zap:hover {
    transform: scale(1.07);
  }
</style>
